# Publication allowlist. Unknown root files stay local until deliberately reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/index.html
!/founderos.html
!/retainiq.html
!/scaleflow.html
!/assets/
!/.nojekyll

# Shared exclusions; example configuration is intentionally public.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.env
**/.env.*
!/.env.example
**/secrets.toml
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.zip
**/*.exe
**/*.msi
**/*.tmp
**/*.bak
**/*~
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/.agents/
**/.codex/
